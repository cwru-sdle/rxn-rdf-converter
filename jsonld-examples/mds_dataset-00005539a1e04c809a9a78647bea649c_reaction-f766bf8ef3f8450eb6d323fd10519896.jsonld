    {
      "@id": "mds:ChemicalReaction.f766bf8ef3f8450eb6d323fd10519896",
      "@type": "mds:ChemicalReaction",
      "cco:ont00001765": "30",
      "cco:ont00001777": [
        {
          "@id": "mds:InputAddition.f766bf8ef3f8450eb6d323fd10519896_Base"
