      ],
      "cco:ont00001986": [
        {
          "@id": "https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#CrudeProduct#4399ad74c4a84693a726596b8c6dc9ab"
        },
        {
          "@id": "https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Product#YRMXJOIHTUIJOT-UHFFFAOYSA-N"
