      "@id": "https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ChemicalReaction#724091f002d04d2ea6bfe923f45ebf01",
      "@type": "mds:ChemicalReaction",
      "cco:ont00001765": "302",
      "cco:ont00001777": [
        {
          "@id": "https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#InputAddition#724091f002d04d2ea6bfe923f45ebf01_Solvent"
        },
