      "mds:formsPrecipitate": "None",
      "mds:isExothermic": "None",
      "mds:isHeterogeneous": "None",
      "mds:isSensitiveToLight": "None",
      "mds:isSensitiveToMoisture": "None",
      "mds:isSensitiveToOxygen": "None",
      "mds:offGasses": "None",
      "mds:procedureDetails": "To a solution of (4-chloro-3-hydroxy-phenyl)acetonitrile (6.2 g, 37 mmol) in CH3CN (80 mL) was added K2CO3 (10.2 g, 74 mmol) and BnBr (7.6 g, 44 mmol). The mixture was stirred at room temperature overnight. The solids were filtered off and the filtrate was evaporated under vacuum. The residue was purified by column chromatography on silica gel (Petroleum Ether/Ethyl Acetate 50:1) to give 2-(3-(benzyloxy)-4-chlorophenyl)acetonitrile (5.6 g, 60%). 1H NMR (400 MHz, CDCl3) δ 7.48-7.32 (m, 6H), 6.94 (d, J=2 Hz, 2H), 6.86 (dd, J=2.0, 8.4 Hz, 1H), 5.18 (s, 2H), 3.71 (s, 2H).",
      "mds:safetyNotes": "None",
