  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#FederatedLearningTraining">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>FederatedLearningTraining</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">Federated Learning (FL) training is the process of collaboratively updating a global model using multiple clients' local data, without sharing the data, by aggregating local model updates over several communication rounds</skos:definition>
    <mds:hasStudyStage> General</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/PlaceHolder"/>
