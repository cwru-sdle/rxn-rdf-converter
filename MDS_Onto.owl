    <skos:altLabel>FluxModel</skos:altLabel>
    <skos:definition>Identifier attached to the flux.</skos:definition>
    <mds:hasStudyStage> General</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/PV-Cell"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ExternalPackaging">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ExternalPackaging</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000020"/>
    <skos:altLabel>Product Container, Protective Casing</skos:altLabel>
