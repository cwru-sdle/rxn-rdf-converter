  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Electrode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Electrode</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="na95f3185f1d14d5e8baecea8ff3fdc52b229"/>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000995"/>
