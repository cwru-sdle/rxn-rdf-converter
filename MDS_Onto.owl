    <mds:hasStudyStage>Sample</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/EnerMat"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na95f3185f1d14d5e8baecea8ff3fdc52b168">
    <rdf:first rdf:nodeID="na95f3185f1d14d5e8baecea8ff3fdc52b165"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#DeadTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">DeadTime</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ImagingParameter"/>
    <skos:altLabel></skos:altLabel>
    <skos:definition xml:lang="en">The period during which an EDS detector is unable to record additional X-ray events following a detection event.</skos:definition>
    <mds:hasStudyStage>Tool</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/EDS"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000023">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">role</rdfs:label>
    <dc:identifier>061-BFO</dc:identifier>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
    <skos:altLabel xml:lang="en">externally-grounded realizable entity</skos:altLabel>
    <skos:definition xml:lang="en">(Elucidation) A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be &amp; b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed</skos:definition>
    <skos:example xml:lang="en">The priest role; the student role; the role of subject in a clinical trial; the role of a stone in marking a property boundary; the role of a boundary to demarcate two neighbouring administrative territories; the role of a building in serving as a military target</skos:example>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#TemperatureControl">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">TemperatureControl</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000908"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">A temperature control is a process where the temperature is kept constant (based on a temperature setpoint) by measuring the temperature of a system and adjust the temperature if the measurement deviates from the setpoint by a threshold.</skos:definition>
    <mds:hasStudyStage>Tool</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Reactions"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Vacuum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vacuum</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000908"/>
    <skos:altLabel>Vacuuming</skos:altLabel>
    <skos:definition xml:lang="en">Vacuum is a process used to reduce pressure in an environment. </skos:definition>
    <mds:hasStudyStage>Formulation</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Formulation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#CopperTube">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">CopperTube</rdfs:label>
