    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">Benchtop is a site (immaterial entity) coincides with a bench (material entity) that serves as an environment for a process such as chemical reaction to take place without the need of specialized equipment to remove volatile fluid.</skos:definition>
    <mds:hasStudyStage>Tool</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Reactions"/>
