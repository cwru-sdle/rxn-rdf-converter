    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000649"/>
    <skos:altLabel> </skos:altLabel>
    <skos:broader rdf:resource="https://www.commoncoreontologies.org/ont00000581"/>
    <skos:definition>Unique ID of a tool</skos:definition>
