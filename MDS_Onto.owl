  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#CarbonBondedToCarbonNitrogenAndOxygenCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">CarbonBondedToCarbonNitrogenAndOxygenCount</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#MoleculeFeature"/>
