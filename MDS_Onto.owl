    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">Inert gases such as argon and nitrogen create an environment which is inert, i.e. chemically inactive, which allows parts to be additively manufactured which meet the exacting standards required for metal parts used in the aerospace and automotive industries.</skos:definition>
    <skos:exactMatch rdf:resource="https://www.emi.fraunhofer.de/ontologies/LPBFO#LPBFO_00020"/>
    <mds:hasStudyStage>Recipe</mds:hasStudyStage>
    <mds:hasStudyStage>Synthesis</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/LPBF"/>
  </rdf:Description>
