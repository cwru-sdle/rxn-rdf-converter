    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000958"/>
    <skos:altLabel>IV Curve</skos:altLabel>
    <skos:altLabel>Trace</skos:altLabel>
    <skos:definition>A current-voltage measurement is a fundamental technique used to characterize the electrical behavior of devices and materials by analyzing the relationship between the voltage applied and the resulting current flow. .</skos:definition>
    <mds:hasStudyStage>Result</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Electrical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#NitrateIon">
