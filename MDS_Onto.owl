  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#QuartzTube">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">QuartzTube</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000718"/>
    <skos:altLabel xml:lang="en">Quartz Tubing</skos:altLabel>
    <skos:definition xml:lang="en">A material with high thermal stability, chemical resistance, and optical clarity, ideal for diverse laboratory applications. [MRC]</skos:definition>
    <mds:hasStudyStage>Tool</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Reactions"/>
    <cco:ont00001754 xml:lang="en">https://www.mrclab.com/quartz-tubes#:~:text=Quarts%20tubes%20offer%20excellent%20thermal,holders%20in%20laboratory%20tube%20furnaces.</cco:ont00001754>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#D50">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">D50</rdfs:label>
    <rdfs:comment xml:lang="en">This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">The portions of particles with diameters smaller and larger than this value are 50%. Also known as the median diameter.</skos:definition>
    <skos:exactMatch rdf:resource="https://www.emi.fraunhofer.de/ontologies/LPBFO#LPBFO_00066"/>
    <mds:hasStudyStage>Result</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/LPBF"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0302888">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">washing</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000094"/>
    <skos:definition xml:lang="en">washing is a process by which a material entity acting as contaminant (e.g. excess staining reagent) is removed by application of one or more cycles of solution. [CHMO]</skos:definition>
    <mds:hasStudyStage>MaterialsProcessing</mds:hasStudyStage>
    <mds:hasStudyStage>Synthesis</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Reactions"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#VoltageLoad">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>VoltageLoad</rdfs:label>
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliV"/>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#AnalyticalResult"/>
    <skos:altLabel>Vld</skos:altLabel>
    <skos:altLabel>Vload</skos:altLabel>
    <skos:definition>The voltage measured across a load (like a resistor, light bulb, or appliance) when it is connected and drawing current.</skos:definition>
    <mds:hasStudyStage>Result</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Electrical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#DispersionEnergy">
