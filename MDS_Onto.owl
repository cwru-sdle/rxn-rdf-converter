    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Wavelength</rdfs:label>
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoM"/>
