  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHMO_0002389">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">totalionchromatogram</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002388"/>
    <skos:altLabel xml:lang="en">TIC</skos:altLabel>
    <skos:definition xml:lang="en">A plot of the total ion current vs. retention time obtained from a chromatography experiment with mass detection. selectivity in the data. The total ion current chromatogram monitors a very large window often of several hundred mass-to-charge units.[CHMO]</skos:definition>
    <mds:hasStudyStage>Analysis</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Reactions"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#HoldTemperature">
