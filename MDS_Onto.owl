    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition>A Quality of a material that describes the relation between the strength or the change in strength of an applied field (magnetic, electric, mechanical stress, etc...) and the strength of the response to that field or to the change in that field in the material, or the extent or nature of chemical changes of a material in response to the presence of some gaseous or liquid substance.</skos:definition>
    <mds:hasStudyStage>Sample</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/General"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000203">
