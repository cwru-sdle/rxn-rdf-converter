  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#RefluxCondenser">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">RefluxCondenser</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ReactionVesselAttachment"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">A glassware device used to cool vapors produced during heating, changing its physical state back into liquid. [Fisher Scientific]</skos:definition>
    <mds:hasStudyStage>Synthesis</mds:hasStudyStage>
    <mds:hasStudyStage>Tool</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Reactions"/>
    <cco:ont00001754 xml:lang="en">https://www.fishersci.com/us/en/browse/90094031/reflux-condensers?page=1#:~:text=Reflux%20condensers%20are%20used%20to,be%20heated%20for%20extended%20periods.</cco:ont00001754>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHMO_0001718">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">evaporativelightscatteringdetection</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001709"/>
    <skos:altLabel xml:lang="en">ELSD</skos:altLabel>
    <skos:definition xml:lang="en">A detection method where a liquid containing the sample is atomised in a gas, forming small droplets which are allowed to evaporate leaving the sample as fine particles. The suspended particles pass through a light beam and the scattered light transmitted by the particles is sensed by a photomultiplier. The response is proportional to the mass of the molecules in the sample.[CHMO]</skos:definition>
    <mds:hasStudyStage>Analysis</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Reactions"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#LaserMode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">LaserMode</rdfs:label>
    <rdfs:comment xml:lang="en">This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">Laser mode used for AM wehere the distribution of the phase position of the waves perpendicular to the direction of propagation is called transverse modes. E.g. With a cylindrical cross-section of the laser, the beam intensity ideally has a Gaussian profile; this mode is known as TEM00 mode.</skos:definition>
    <skos:exactMatch rdf:resource="https://www.emi.fraunhofer.de/ontologies/LPBFO#LPBFO_00024"/>
    <mds:hasStudyStage>Recipe</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/LPBF"/>
  </rdf:Description>
