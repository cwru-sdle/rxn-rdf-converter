  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#PhotovoltaicModule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>PhotovoltaicModule</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Sample"/>
    <skos:altLabel>Module</skos:altLabel>
    <skos:altLabel>PV Module</skos:altLabel>
    <skos:altLabel>Photovoltaic Module</skos:altLabel>
    <skos:altLabel>Solar Panel</skos:altLabel>
    <skos:altLabel>module</skos:altLabel>
    <skos:definition>A photovoltaic module is a collection of solar cell circuits sealed in an environmentally protective laminate. Packaging of modules typically includes layering cells between materials such as glass for the front and back, a top and rear encapsulation layer, cells and interconnects, passivation layers and optical coatings, all enclosed in a metal frame. Performance of PV modules are generally rated according to their electrical outputs under standard test conditions. Modules are used in the field together as arrays that make up a power generation site. </skos:definition>
    <mds:hasStudyStage>Sample</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/PV-Cell"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#FluxModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
