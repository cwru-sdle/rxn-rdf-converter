  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ExposureOrderOnScanVectors">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ExposureOrderOnScanVectors</rdfs:label>
    <rdfs:comment xml:lang="en">This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">This process describes the application of the stored exposure strategy, which also contains rules for up- and down-skin areas and contours, to the scan vectors. For each scan vector, the affiliation to the different areas is determined beforehand so that the rules can be applied. Output of this process is the CNCExposureOrderFile.</skos:definition>
