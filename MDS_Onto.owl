    <skos:definition xml:lang="en">A Thermocouple which can be operated from -270°C to 1260°C (approx.).</skos:definition>
    <mds:hasStudyStage>Tool</mds:hasStudyStage>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na95f3185f1d14d5e8baecea8ff3fdc52b243">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#DeepFeatureLearning"/>
    <owl:onProperty rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#usesFeatureExtraction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ReactionPressure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ReactionPressure</rdfs:label>
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaPA"/>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ProcessingPressure"/>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000380"/>
    <skos:altLabel></skos:altLabel>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">A reaction pressure is a pressure set within a reaction environment and glassware under a chemical reaction.</skos:definition>
    <skos:definition xml:lang="en">A reaction pressure is the pressure during a chemical reaction process inside the reaction glassware inheres by the reaction environment.</skos:definition>
    <skos:definition xml:lang="en">The pressure maintained during a chemical reaction.</skos:definition>
    <mds:hasStudyStage>Process</mds:hasStudyStage>
    <mds:hasStudyStage>Synthesis</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Formulation"/>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/MaterialsProcessing"/>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Reactions"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHMO_0002572">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Schlenktube</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000968"/>
    <skos:altLabel xml:lang="en">Schlenk flask</skos:altLabel>
    <skos:definition xml:lang="en">A piece of apparatus used as a reaction vessel in air-sensitive chemistry. It is made of glass and has a side arm fitted with a PTFE or ground glass stopcock which allows the vessel to be evacuated or filled with gas (e.g. nitrogen or argon).[CHMO]</skos:definition>
    <mds:hasStudyStage>Synthesis</mds:hasStudyStage>
    <mds:hasStudyStage>Tool</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Reactions"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#RecoaterSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">RecoaterSystem</rdfs:label>
    <rdfs:comment xml:lang="en">This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">A set of horizontal bars that spreads and smooths liquid polymer in vat photopolymerization or powder for powder bed fusion and binder jet processes to create a uniform and flat layer before the build material is solidified, sintered, melted, or bonded. A recoater system can be composed of several coaters (blades), e.g. in a two-blade system.</skos:definition>
    <skos:exactMatch rdf:resource="https://www.emi.fraunhofer.de/ontologies/LPBFO#LPBFO_00023"/>
    <mds:hasStudyStage>MaterialsProcessing</mds:hasStudyStage>
    <mds:hasStudyStage>Tool</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/LPBF"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ImpactSensitivityCalculated">
