  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00000806">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">PowerTool</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000581"/>
    <skos:definition xml:lang="en">A Tool that is designed to be actuated by a Power Source and mechanism other than or in addition to manual labor.</skos:definition>
    <mds:hasStudyStage>Tool</mds:hasStudyStage>
    <cco:ont00001754 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/w/index.php?title=Power_tool&amp;oldid=1057147715</cco:ont00001754>
