    <owl:disjointWith rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#PolymericMaterial"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition>A material containing a continuous and dispersed phase, and whose constituent phases, if separated, would be classified under distinct types among ceramic, metallic, or polymeric materials.</skos:definition>
