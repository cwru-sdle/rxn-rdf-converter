    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
    <skos:altLabel>PVSite</skos:altLabel>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">A facility that turns sunlight into electricity using solar panels. It feeds power directly into the regional grid.</skos:definition>
    <skos:definition xml:lang="en">A PV site is a location where photovoltaic panels are installed to generate electricity from sunlight.</skos:definition>
