    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ProcessParameters"/>
    <skos:definition xml:lang="en">Any external force, torque, or weight applied to a system, machine, or structural component that causes stress and potential deformation . There are three types of load: axial, transverse, and torsional.</skos:definition>
