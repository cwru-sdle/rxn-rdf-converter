    <rdfs:label xml:lang="en">HoldTemperature</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#AnnealingParameter"/>
    <skos:definition>The temperature at which a specimen is held during heat treatment. </skos:definition>
    <mds:hasStudyStage>MaterialsProcessing</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/MaterialsProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#UvVisSpectroscopy">
