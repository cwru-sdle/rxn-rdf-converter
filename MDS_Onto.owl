    <skos:definition xml:lang="en">A form of acoustic microscopy in which a scanned electron beam generates elastic waves within the specimen, which are then detected to image subsurface structure.</skos:definition>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Microscopy"/>
    <mds:hasStudyStage>Analysis</mds:hasStudyStage>
