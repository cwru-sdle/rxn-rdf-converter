  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Component">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Component</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
    <skos:altLabel></skos:altLabel>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">In a chemical reaction context, a component is a constituent of a mixture where the amount or concentration of which can be varied independently. The number of components in a given system is the minimum number of independent species necessary to define the composition in all the phases of a system. It may vary with external conditions since additional chemical equilibria reduce the number of components. The term component is also often used in the more general sense as defined here under constituent. [IUPAC]</skos:definition>
    <mds:hasStudyStage>Sample</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Formulation"/>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Reactions"/>
    <cco:ont00001754 xml:lang="en">https://doi.org/10.1351/goldbook.C01209</cco:ont00001754>
  </rdf:Description>
