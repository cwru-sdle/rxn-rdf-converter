  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ContourCorridorParameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ContourCorridorParameter</rdfs:label>
    <dcterms:source xml:lang="en">EOSPRINT 2</dcterms:source>
    <qudt:hasUnit xml:lang="en">mm</qudt:hasUnit>
    <rdfs:comment xml:lang="en">This term is reused from https://github.com/ThomasBjarsch/ODE_AM/blob/main/PBFAO.ttl</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contour parameter prescribing the range in x,y-plane, in which the exposed areas underneath and above the current layer are considered, to determine the conture exposure type</skos:definition>
    <skos:exactMatch rdf:resource="https://w3id.org/ODE_AM/PBFAO/ContourCorridorParameter"/>
    <skos:example xml:lang="en">0,07 mm</skos:example>
    <mds:hasStudyStage>MaterialsProcessing</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/LPBF"/>
  </rdf:Description>
