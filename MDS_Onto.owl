    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/SEM"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#WasteThermalEnergy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">WasteThermalEnergy</rdfs:label>
    <rdfs:comment xml:lang="en">This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl.</rdfs:comment>
    <rdfs:seeAlso xml:lang="en">https://en.wikipedia.org/wiki/Waste_heat</rdfs:seeAlso>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">Thermal enegy is defined as a energy which is produced by a machine, or other process that uses energy, as a byproduct of doing work. All such processes give off some waste heat as a fundamental result of the laws of thermodynamics.</skos:definition>
    <skos:exactMatch rdf:resource="https://www.emi.fraunhofer.de/ontologies/LPBFO#LPBFO_00813"/>
    <mds:hasStudyStage> General</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/LPBF"/>
  </rdf:Description>
