  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHMO_0002858">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">diasteromericratio</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000145"/>
    <skos:altLabel xml:lang="en">DR</skos:altLabel>
    <skos:definition xml:lang="en">The ratio of the percentage of one diastereomer in a mixture to that of the other.[CHMO]</skos:definition>
    <skos:definition xml:lang="en">This is defined by analogy with enantiomeric ratio as the ratio of the percentage of one diastereoisomer in a mixture to that of the other [IUPAC]. </skos:definition>
    <mds:hasStudyStage>Synthesis</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Reactions"/>
    <cco:ont00001754 xml:lang="en">https://doi.org/10.1351/goldbook.D01681</cco:ont00001754>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#hasHoldTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasHoldTime</rdfs:label>
    <rdfs:domain rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Sample"/>
    <rdfs:range rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#HoldTime"/>
    <skos:definition>Informs how long a specimen was held at a temperature during annealing </skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Sensitivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Sensitivity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition>The detector's ability to accurately measure and respond to small amounts of infrared radiation.</skos:definition>
    <skos:definition>The slope of the calibration curve. If the curve is in fact a 'curve', rather than a straight line, then of course sensitivity will be a function of analyte concentration or amount. If sensitivity is to be a unique performance characteristic, it must depend only on the chemical measurement process, not upon scale factors. ( IUPAC)</skos:definition>
    <skos:exactMatch rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Sensitivity"/>
    <mds:hasStudyStage> General</mds:hasStudyStage>
    <mds:hasStudyStage>Sample</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/EnerMat"/>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/General"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#hasModule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasmodule</rdfs:label>
    <rdfs:domain rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#PVString"/>
    <rdfs:range rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#PVModule"/>
    <rdfs:subPropertyOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#hasPart"/>
    <skos:definition xml:lang="en">Relates a PV string to one of its series-connected PV modules.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#DensityExperimental">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>DensityExperimental</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000009"/>
    <skos:definition>Density measured via experimentation</skos:definition>
    <mds:hasStudyStage>Sample</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/EnerMat"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#FacilityAmbientTemperature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>FacilityAmbientTemperature</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#SiteParameter"/>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000441"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition>The ambient temperature of the room that a current voltage process is being performed in.</skos:definition>
    <mds:hasStudyStage>Recipe</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Electrical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ThermalStability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ThermalStability</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ThermalProperty"/>
    <skos:definition>Stability of a water body and its resistance to mixing.(Wikipedia)</skos:definition>
    <mds:hasStudyStage>Sample</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/EnerMat"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Selectivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Selectivity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">It sometimes refers to the discrimination shown by a given reactant A when it reacts with two alternative reactants B and C, or in two different ways (e.g. at two different sites) with a reactant B. The term also sometimes refers to the ratio of products obtained from given reactants. This meaning is of importance for catalysts, which can have a wide range of selectivities. Selectivity is quantitatively expressed by ratios of rate constants for the alternative reactions, or by the decadic logarithms of such ratios.[IUPAC]</skos:definition>
    <mds:hasStudyStage> General</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Reactions"/>
    <cco:ont00001754 xml:lang="en">https://doi.org/10.1351/goldbook.S05563</cco:ont00001754>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#SchoolName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">SchoolName</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000649"/>
    <skos:altLabel xml:lang="en">Name of School</skos:altLabel>
    <skos:definition>Name of the school</skos:definition>
    <mds:hasStudyStage>General</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/PV-Site"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027">
