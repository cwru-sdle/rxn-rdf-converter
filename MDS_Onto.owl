  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHMO_0001007">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">thinlayerchromatography</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001005"/>
    <skos:altLabel xml:lang="en">TLC</skos:altLabel>
    <skos:definition xml:lang="en">A chromatography method where the stationary phase is a thin (0.10 to 0.25 mm) layer of sorbent applied to a firm backing such as glass, aluminium or plastic sheet. An eluent ( single solvent or solvent mixture) is allowed to flow by capillary action through the sorbent starting at a point just below the applied samples. As the eluent front migrates through the sorbent the components of the sample also migrate, but at different rates resulting in separation. [CHMO]</skos:definition>
    <mds:hasStudyStage>Analysis</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Reactions"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na95f3185f1d14d5e8baecea8ff3fdc52b322">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
