    <rdfs:comment xml:lang="en">This term is reused from https://github.com/ThomasBjarsch/ODE_AM/blob/main/PBFAO.ttl</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edge parameter prescribing that if the ratio beam-outline to contour-outline extends 'threshold time beamoffset', edges will be exposed with edgefactor of 1,45</skos:definition>
