  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Tolerance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Tolerance</rdfs:label>
    <rdfs:comment>This is often in a percent range to either side of a given specification, but it accepts discrete values as well.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000127"/>
    <skos:altLabel>Operational Tolerance</skos:altLabel>
    <skos:definition>A Performance Specification that prescribes some allowable or anticipated deviation from an operational or performance expectation.</skos:definition>
    <skos:example>A capacitor has a capacitance fluctuation of ±15% maximum, a steel beam has a length of 3 meters with a tolerance of ±10 centimeters.</skos:example>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/General"/>
  </rdf:Description>
