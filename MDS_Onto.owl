    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliM"/>
    <rdfs:comment xml:lang="en">This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO</rdfs:comment>
