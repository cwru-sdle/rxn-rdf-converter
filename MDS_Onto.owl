    <skos:altLabel>Uv-Vis Spectroscopy</skos:altLabel>
    <skos:altLabel>UvVis Spectroscopy</skos:altLabel>
    <skos:definition>The act of characterizing absorbance and transmittance of ultraviolet and visible light through a material</skos:definition>
    <mds:hasStudyStage>Analysis</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/UV-Vis"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#SatelliteAltitude">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SatelliteAltitude</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000787"/>
    <skos:altLabel>OperatingAltitude</skos:altLabel>
    <skos:altLabel>ScanningAltitude</skos:altLabel>
