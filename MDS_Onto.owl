  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ProcessParameters">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ProcessParameters</rdfs:label>
    <rdfs:comment xml:lang="en">This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl.</rdfs:comment>
    <rdfs:isDefinedBy xml:lang="en"> ISO/ASTM 52900</rdfs:isDefinedBy>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
    <skos:altLabel></skos:altLabel>
    <skos:definition xml:lang="en">A set of operating parameters and system settings used to control a material or manufacturing process.</skos:definition>
    <skos:scopeNote xml:lang="en">Originally defined narrowly as 'set of operating parameters and system settings used during a construction cycle in additive manufacturing' (per LPBFO reuse); broadened here for shared use across process domains.</skos:scopeNote>
