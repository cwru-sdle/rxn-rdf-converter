  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Defect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Defect</rdfs:label>
    <rdfs:comment>(Elucidation) A Defect is conceptualized to be some region (or a discontinuous aggregate of regions) in a material in direct contact with a crystal, that contains or lacks material entities in a way that disrupts the repeating patterns of a perfect crystal.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition>An Immaterial Entity that disrupts the continuity of unit cell repetition in a solid substance.</skos:definition>
    <mds:hasStudyStage> General</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/PlaceHolder"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na95f3185f1d14d5e8baecea8ff3fdc52b336">
