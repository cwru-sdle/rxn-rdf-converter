  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#MultiLayerCeramicCapacitor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>MultiLayerCeramicCapacitor</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="na95f3185f1d14d5e8baecea8ff3fdc52b230"/>
    <rdfs:subClassOf rdf:nodeID="na95f3185f1d14d5e8baecea8ff3fdc52b231"/>
    <rdfs:subClassOf rdf:nodeID="na95f3185f1d14d5e8baecea8ff3fdc52b232"/>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Capacitor"/>
    <skos:altLabel>MLCC</skos:altLabel>
    <skos:definition>An MLCC is a capacitor that is designed with multiple layers of dielectric and metal</skos:definition>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Electrical"/>
