    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000323"/>
    <skos:altLabel></skos:altLabel>
    <skos:definition xml:lang="en">A processing aid function that is realized in a material additive used for mixing, extrusion, and molding of a particular formulation</skos:definition>
    <mds:hasStudyStage>Formulation</mds:hasStudyStage>
    <mds:hasStudyStage>Sample</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Formulation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Crystal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Crystal</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition>An Object that is three-dimensional in extent, composed of spatially repeatable units of a specific atomic configuration called a unit cell, where the repetition occurs throughout a large length scale compared to the atomic scale.</skos:definition>
    <mds:hasStudyStage>Sample</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/PlaceHolder"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#WaterVaporTransmissionRate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">WaterVaporTransmissionRate</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ArtifactDesign"/>
    <skos:altLabel xml:lang="en">Moisture Vapor Transmission Rate</skos:altLabel>
