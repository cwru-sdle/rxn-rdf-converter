  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ParticleSizeDistribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ParticleSizeDistribution</rdfs:label>
    <rdfs:comment xml:lang="en">This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO/-/blob/master/LPBFO_merged.ttl.</rdfs:comment>
    <rdfs:isDefinedBy xml:lang="en">Jillavenkatesa A, Dapkunas S J, Lin-Sien Lum, Particle Size Characterization, NIST Special Publication 960-1, 2001</rdfs:isDefinedBy>
    <rdfs:seeAlso xml:lang="en">https://en.wikipedia.org/wiki/Particle-size_distribution</rdfs:seeAlso>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">The particle-size distribution (PSD) of a powder, or granular material, or particles dispersed in fluid, is a list of values or a mathematical function that defines the relative amount, typically by mass, of particles present according to size.</skos:definition>
    <skos:exactMatch rdf:resource="https://www.emi.fraunhofer.de/ontologies/LPBFO#LPBFO_00004"/>
    <mds:hasStudyStage>Result</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/LPBF"/>
  </rdf:Description>
