    <owl:inverseOf rdf:resource="https://www.commoncoreontologies.org/ont00001777"/>
    <skos:definition xml:lang="en">x is_part_of_process y iff x and y are instances of Process, such that x occurs during the temporal interval of y, and x either provides an input to y or receives an output of y.</skos:definition>
    <skos:exactMatch rdf:resource="https://www.commoncoreontologies.org/ont00001857"/>
