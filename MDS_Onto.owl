  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#GlassTransitionDisposition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>GlassTransitionDisposition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ThermalDisposition"/>
    <skos:altLabel>TG, T_G</skos:altLabel>
    <skos:definition>A thermal disposition realized in an amorphous material upon crossing its glass transition temperature wherein the material transitions to a soft and rubbery state from its standard brittle and hard state.</skos:definition>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Electrical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#CurrentVoltageMeasurment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
