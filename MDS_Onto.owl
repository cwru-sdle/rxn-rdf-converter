    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001130"/>
    <skos:definition xml:lang="en">A Geospatial Polygon that has some Geospatial Region as a non-tangential proper part.</skos:definition>
    <skos:exactMatch rdf:resource="https://www.commoncoreontologies.org/ont00000358"/>
    <mds:hasStudyStage> General</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/PlaceHolder"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#MonochromatorRotation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>MonochromatorRotation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition>The rotational positioning of a monochromator crystal to select specific X-ray energies through Bragg angle adjustment.</skos:definition>
    <mds:hasStudyStage>Recipe</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/XRD"/>
