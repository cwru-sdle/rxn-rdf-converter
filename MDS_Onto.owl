    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/EDS"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00000614">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mass</rdfs:label>
    <rdfs:comment xml:lang="en">'Matter' here can also refer to the inertial energy of an object.</rdfs:comment>
    <rdfs:comment xml:lang="en">Typical unit of measure is the kilogram or pound.</rdfs:comment>
