    <skos:altLabel>Layer Height</skos:altLabel>
    <skos:altLabel xml:lang="en">Additive Manufacturing Layer Thickness</skos:altLabel>
    <skos:definition xml:lang="en">Layer thickness in 3D printing is a measure of the layer height of each successive addition of material in the additive manufacturing or 3D printing process in which layers are stacked.</skos:definition>
