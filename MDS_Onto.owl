  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#MetallicMaterial">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">MetallicMaterial</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Material"/>
    <owl:disjointWith rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#PolymericMaterial"/>
    <skos:altLabel> </skos:altLabel>
