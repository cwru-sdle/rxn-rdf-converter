    <mds:hasStudyStage>Tool</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Reactions"/>
    <cco:ont00001754 xml:lang="en">https://en.wikipedia.org/wiki/Copper_tubing</cco:ont00001754>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#EntanglementWeight">
