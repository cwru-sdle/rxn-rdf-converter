    <rdfs:domain rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Channel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The electrical domain of the quantity recorded by a channel: 'AC' or 'DC'. Omitted for non-electrical (e.g., meteorological) channels.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ScanningElectronAcousticMicroscopy">
