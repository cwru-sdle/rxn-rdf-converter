    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#MechanicalProperty"/>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Modulus"/>
    <skos:altLabel></skos:altLabel>
    <skos:definition xml:lang="en">A measurement of the material's elasticity by energy stored and recoverd during deformation. </skos:definition>
    <skos:definition xml:lang="en">A measure of the materials elasticity during dynamic loading. </skos:definition>
    <skos:exactMatch rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#StorageModulus"/>
