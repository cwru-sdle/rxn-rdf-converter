    <skos:altLabel> </skos:altLabel>
    <skos:altLabel></skos:altLabel>
    <skos:definition xml:lang="en">A reaction setup is a planned process that involves setting up the equipment and glassware for a planned reaction. [CHMO]</skos:definition>
    <skos:definition xml:lang="en">A reaction setup is a planned process that involves setting up the equipment and glassware for a planned reaction.</skos:definition>
    <mds:hasStudyStage>Synthesis</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Reactions"/>
