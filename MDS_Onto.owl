  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00000910">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Amplitude</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000144"/>
    <skos:definition xml:lang="en">A Process Profile of an Oscillation Process that is the absolute value of the maximum displacement from a zero, equilibrium, or mean value during one cycle of the Oscillation Process.</skos:definition>
    <mds:hasStudyStage>Result</mds:hasStudyStage>
    <cco:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/EventOntology</cco:ont00001760>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#HotIsostaticPressing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">HotIsostaticPressing</rdfs:label>
    <dcterms:source>ASTM F2924-14</dcterms:source>
    <rdfs:subClassOf rdf:nodeID="na95f3185f1d14d5e8baecea8ff3fdc52b58"/>
    <rdfs:subClassOf rdf:nodeID="na95f3185f1d14d5e8baecea8ff3fdc52b59"/>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#MaterialsProcessing"/>
    <skos:altLabel>HIP</skos:altLabel>
    <skos:altLabel>Hot Isostatic Compaction</skos:altLabel>
    <skos:definition xml:lang="en">A manufacturing process that subjects materials to both elevated temperature and isostatic gas pressure in a high-pressure containment vessel to eliminate porosity and increase density.</skos:definition>
    <mds:hasStudyStage>MaterialsProcessing</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/MaterialsProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#PrincetonQuadro">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>PrincetonQuadro</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#PrincetonDetector"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition>Princeton Quadro X-ray detector.</skos:definition>
    <mds:hasStudyStage>Tool</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/XRD"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Flowability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Flowability</rdfs:label>
    <rdfs:comment xml:lang="en">This term is reused from https://gitlab.cc-asp.fraunhofer.de/EMI_datamanagement/LPBFO</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">Flowability is an umbrella term describing the complex behaviour of powder when it is mobilized. Flowability is not one comprehensive property of bulk powder.  The term 'flowability' always must relate to equipment and the way in which it was tested. One example of such a test is the so-called avalanche test which allows a statistical analysis and extraction of distribution characteristics of quite a number of different parameters like avalanche angle, surface fractal, volume expansion rate and many more.</skos:definition>
    <skos:exactMatch rdf:resource="https://www.emi.fraunhofer.de/ontologies/LPBFO#LPBFO_00718"/>
    <mds:hasStudyStage>Sample</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/LPBF"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ProcessParameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ProcessParameter</rdfs:label>
    <rdfs:isDefinedBy>ISO/ASTM 52900</rdfs:isDefinedBy>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition>A Directive Information Content Entity that prescribes one or more parameter values governing an additive manufacturing process.</skos:definition>
    <mds:hasStudyStage>Recipe</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/MaterialsProcessing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00001359">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ActofManufacturing</rdfs:label>
    <rdfs:comment xml:lang="en">An Act of Manufacturing typically involves the mass production of goods.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000908"/>
    <skos:definition xml:lang="en">An Act of Artifact Processing wherein Artifacts are created in a Facility for the purpose of being sold to consumers.</skos:definition>
    <mds:hasStudyStage>MaterialsProcessing</mds:hasStudyStage>
    <cco:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/EventOntology</cco:ont00001760>
  </rdf:Description>
