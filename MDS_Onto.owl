  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHMO_0000113">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>atomicforcemicroscopy</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000112"/>
    <skos:altLabel>AFM</skos:altLabel>
    <skos:altLabel>SFM</skos:altLabel>
    <skos:altLabel>atomic force imaging</skos:altLabel>
    <skos:altLabel>scanning force microscopy</skos:altLabel>
    <skos:definition>Microscopy which uses a sharp spike (known as a 'tip') mounted on the end of a cantilever to scan the surface of the specimen. An image of the surface is obtained by mechanically moving the probe in a raster scan of the specimen, line by line, and recording the force experienced by the tip as a function of position. A feedback loop is used to maintain a fixed relationship between the tip and surface during scanning.[CHMO]</skos:definition>
    <mds:hasStudyStage>Analysis</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/AFM"/>
  </rdf:Description>
