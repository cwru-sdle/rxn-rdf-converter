  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00001841">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000056"/>
    <owl:inverseOf rdf:resource="https://www.commoncoreontologies.org/ont00001921"/>
    <rdfs:domain rdf:nodeID="na95f3185f1d14d5e8baecea8ff3fdc52b328"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
    <rdfs:label xml:lang="en">is input of</rdfs:label>
    <skos:definition xml:lang="en">x is input of y =Def x participates in y, x is an Independent Continuant (but not a Spatial Region), y is a Process, and the presence of x at the beginning of y is a necessary condition for the start of y.</skos:definition>
