  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#AnalyticalResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">AnalyticalResult</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000958"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">An analytical result is an information content entity that is about the outcome of an analysis process. The analysis process can be a characterization method (UV-VIS or NMR) or a data analysis method such as calculating the mean/average.</skos:definition>
    <skos:example xml:lang="en">In the chemical reaction context, an analytical result is an information content entity that is about a product (output) of a chemical reaction process determined by a measuring process such as percentage yield calculated via the mass measured.</skos:example>
    <mds:hasStudyStage>Analysis</mds:hasStudyStage>
    <mds:hasStudyStage>Result</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Reactions"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Cap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cap</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ReactionVesselAttachment"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition xml:lang="en">A cap is a removable seal used to contain or control chemical reactions fitted for a piece of glassware.</skos:definition>
    <mds:hasStudyStage>Tool</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Reactions"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#pH">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pH</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ChemicalProperty"/>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001022"/>
    <skos:altLabel></skos:altLabel>
    <skos:definition xml:lang="en">pH is a chemical property that designates acidity or alkalinity of a solution or formulation. It is relevant for some specialty silicone dispersions</skos:definition>
    <skos:scopeNote xml:lang="en">This property is a measured result for an uncured polymer</skos:scopeNote>
    <mds:hasStudyStage>Sample</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Formulation"/>
  </rdf:Description>
