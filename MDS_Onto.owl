    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ImpactSensitivity"/>
    <skos:definition>Impact sensitivity measured through a calculation</skos:definition>
    <mds:hasStudyStage>Sample</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/EnerMat"/>
  </rdf:Description>
