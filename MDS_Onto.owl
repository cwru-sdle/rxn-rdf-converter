    <skos:altLabel xml:lang="en">Water Vapour Transmission Rate</skos:altLabel>
    <skos:definition xml:lang="en">A transport quality that characterizes the quantity of water vapor transmitted through a material per unit area during a specified period of time.</skos:definition>
    <mds:hasStudyStage>Analysis</mds:hasStudyStage>
    <mds:hasStudyStage>Result</mds:hasStudyStage>
    <mds:hasStudyStage>Sample</mds:hasStudyStage>
