    <skos:altLabel></skos:altLabel>
    <skos:definition xml:lang="en">Proportion of constituent's mass to the total mass.</skos:definition>
    <skos:definition xml:lang="en">The proportion of an element expressed as a percentage of the total specimen mass.</skos:definition>
    <mds:hasStudyStage>Result</mds:hasStudyStage>
    <mds:hasStudyStage>Sample</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/EDS"/>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Formulation"/>
  </rdf:Description>
