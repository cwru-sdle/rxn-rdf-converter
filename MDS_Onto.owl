  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#CurrentVoltageResultsTimestamp">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>CurrentVoltageResultsTimestamp</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#Date"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition>The datetime when a current voltage process was executed.</skos:definition>
    <mds:hasStudyStage>Result</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Electrical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#DielectricConstant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">DielectricConstant</rdfs:label>
    <rdfs:comment xml:lang="en">It is defined as the ratio of a capacitor's capacitance with a dielectric material to its capacitance with a vacuum, or the ratio of the material's permittivity to the permittivity of free space. A higher dielectric constant indicates that a material is better at insulating and storing charge, while a lower constant means it is closer to a vacuum's insulating properties.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#AnalyticalResult"/>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ElectricalProperty"/>
    <skos:altLabel xml:lang="en">Relative permittivity</skos:altLabel>
    <skos:definition xml:lang="en">Dielectric constant is also known as relative permittivity and it is a measure of a measure of a material's ability to store electrical energy in an electric field compared to a vacuum.</skos:definition>
    <skos:scopeNote xml:lang="en">This property is for a cured polymer. </skos:scopeNote>
    <mds:hasStudyStage>Characterization</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/Formulation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#CrystallineAlloy">
