    <rdfs:label>OpticalProperty</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
    <rdfs:subClassOf rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#MaterialProperty"/>
    <skos:altLabel> </skos:altLabel>
    <skos:definition>A Material Property that measures the relation between some quantitative property of an electromagnetic radiation and the change in some property of that incident radiation due to interaction with the material.</skos:definition>
    <skos:definition>The optical properties of a material define how it interacts with light. </skos:definition>
    <skos:exactMatch rdf:resource="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#OpticalProperty"/>
    <mds:hasStudyStage>Sample</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/XRD"/>
  </rdf:Description>
