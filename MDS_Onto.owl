    <mds:hasStudyStage>Sample</mds:hasStudyStage>
    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/EnerMat"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ReactionSetup">
