    <mds:inDomain rdf:resource="https://cwrusdle.bitbucket.io/mdsdom/General"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cwrusdle.bitbucket.io/files/MDS_Onto/index-en.html#ExposureStrategy">
